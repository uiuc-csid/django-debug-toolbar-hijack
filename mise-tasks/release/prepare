#!/usr/bin/env bash
#MISE description="Open a release PR: bump the version and update CHANGELOG.md on a release/vX branch"
#USAGE arg "<version>" help="An explicit version (e.g. 0.1.0b2) or a `uv version --bump` keyword: major, minor, patch, stable, alpha, beta, rc, post or dev"
#USAGE flag "-n --dry-run" help="Show every step, the new version and the CHANGELOG.md diff without changing anything"
#USAGE flag "--no-pr" help="Stop after the local commit and print the push and PR commands"
#
# Step one of a release; `mise run release:tag` is step two. `main` is
# protected (PRs and CI only), so the release commit goes through a PR:
# this task creates `release/vX` from an up-to-date, clean `main`, commits the
# version bump and changelog, pushes the branch and opens the PR. It never
# pushes to `main` and never creates a tag.
#
# Every check (including the CHANGELOG.md rewrite) runs before anything is
# modified, so a refusal leaves the tree untouched.
#
# Empty [Unreleased] rule: a release must have changelog entries, except a
# pre-release that follows another pre-release of the same version (for
# example 0.1.0b1 -> 0.1.0b2 or 0.1.0b2 -> 0.1.0rc1). Such a release gets a
# "No changes since X." line. A final release (0.1.0rc1 -> 0.1.0) or a
# pre-release of a new version (0.1.0b1 -> 0.2.0b1) always needs entries.
set -Eeuo pipefail

bump_keywords="major minor patch stable alpha beta rc post dev"

version_arg=${usage_version:?missing version argument}
dry_run=false
open_pr=true
[ "${usage_dry_run:-false}" = true ] && dry_run=true
[ "${usage_no_pr:-false}" = true ] && open_pr=false

# shellcheck source=mise-tasks/release/.lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/.lib.sh"

if $dry_run; then
	printf 'Dry run: nothing will be changed.\n'
fi

# --- 1. Preconditions --------------------------------------------------------
step "1. Check the repository state"

require_clean_tree
require_on_main
require_up_to_date

if $open_pr; then
	command -v gh >/dev/null || die "gh is not installed; install it or pass --no-pr"
	gh auth status >/dev/null 2>&1 || die "gh is not logged in; run 'gh auth login' or pass --no-pr"
	info "gh is installed and logged in"
fi

current_version=$(uv version --short)
case " $bump_keywords " in
*" $version_arg "*) uv_version_args=(--bump "$version_arg") ;;
*) uv_version_args=("$version_arg") ;;
esac
new_version=$(uv version "${uv_version_args[@]}" --dry-run --short) || die "uv could not compute a new version from '$version_arg'"

# Compare with packaging (a dependency of the dev group, so it's in .venv).
# Prints whether the new and current versions are pre-releases and whether
# they share a release (e.g. 0.1.0b1 and 0.1.0rc1 both release 0.1.0).
read -r new_is_pre current_is_pre same_release < <(
	python - "$current_version" "$new_version" <<'EOF'
import sys
from packaging.version import Version

current, new = map(Version, sys.argv[1:])
if new <= current:
    sys.exit(f"error: {new} is not newer than the current version {current}")
print(
    str(new.is_prerelease).lower(),
    str(current.is_prerelease).lower(),
    str(new.release == current.release).lower(),
)
EOF
) || exit 1
tag="v$new_version"
release_branch="release/$tag"
info "version: $current_version -> $new_version (branch $release_branch, tag $tag)"

require_ref_absent "refs/tags/$tag" "tag $tag"
require_ref_absent "refs/heads/$release_branch" "branch $release_branch"

# Build the new CHANGELOG.md now, so an empty [Unreleased] is caught before
# anything is changed.
grep -q '^## \[Unreleased\]' "$changelog" || die "$changelog has no '## [Unreleased]' section"
if grep -q "^## \[$new_version\]" "$changelog"; then
	die "$changelog already has a section for $new_version"
fi
empty_note=""
if [ "$new_is_pre" = true ] && [ "$current_is_pre" = true ] && [ "$same_release" = true ]; then
	empty_note="No changes since $current_version."
fi
release_date=$(date +%Y-%m-%d)
new_changelog="$tmpdir/$changelog"
awk_status=0
awk -v version="$new_version" -v date="$release_date" -v tag="$tag" -v note="$empty_note" '
function flush(   i, first, last) {
	first = 1; last = n
	while (first <= last && body[first] ~ /^[[:space:]]*$/) first++
	while (last >= first && body[last] ~ /^[[:space:]]*$/) last--
	if (first > last && note == "") exit 3
	print ""
	print "## [" version "] - " date
	print ""
	if (first > last) print note
	for (i = first; i <= last; i++) print body[i]
	print ""
	state = 2
}
state == 0 {
	print
	if ($0 ~ /^## \[Unreleased\]/) state = 1
	next
}
state == 1 {
	if ($0 ~ /^## \[/ || $0 ~ /^\[[^]]+\]: /) flush()
	else { body[++n] = $0; next }
}
state == 2 && /^\[Unreleased\]: / {
	start = index($0, "/compare/")
	stop = index($0, "...HEAD")
	if (start && stop > start) {
		# "[Unreleased]: " is 14 characters; keep the URL through "/compare/".
		prefix = substr($0, 15, start - 6)
		base = substr($0, start + 9, stop - start - 9)
		print "[Unreleased]: " prefix tag "...HEAD"
		print "[" version "]: " prefix base "..." tag
		links = 1
		next
	}
}
{ print }
END {
	if (state == 1) flush()
	if (!links) exit 4
}
' "$changelog" >"$new_changelog" || awk_status=$?
case $awk_status in
0)
	if [ -n "$empty_note" ] && grep -qF -- "$empty_note" "$new_changelog"; then
		info "$changelog: [Unreleased] is empty; [$new_version] - $release_date will say \"$empty_note\""
	else
		info "$changelog: [Unreleased] entries will move under [$new_version] - $release_date"
	fi
	;;
3) die "the [Unreleased] section of $changelog is empty; add entries first (only a pre-release that follows a pre-release of the same version may be empty)" ;;
4) warn "no '[Unreleased]: .../compare/<tag>...HEAD' link in $changelog; compare links not updated" ;;
*) die "could not update $changelog" ;;
esac

# The PR body: the new changelog section (without its heading), then the next step.
pr_body="$tmpdir/pr-body.md"
{
	awk -v heading="## [$new_version] - " '
		index($0, heading) == 1 { found = 1; next }
		found && (/^## \[/ || /^\[[^]]+\]: /) { exit }
		found { print }
	' "$new_changelog" | sed -e '/./,$!d'
	cat <<EOF
---

Release $tag. After this PR is merged, tag the merge and publish to PyPI from an up-to-date \`main\`:

\`\`\`bash
git switch $branch && git pull --ff-only
mise run release:tag --dry-run
mise run release:tag --push
\`\`\`

Pushing the tag starts the Release workflow (\`.github/workflows/release.yml\`), which publishes to PyPI.
EOF
} >"$pr_body"

# --- 2. CI -------------------------------------------------------------------
step "2. Run CI"
run mise run ci

# --- 3. Branch ---------------------------------------------------------------
step "3. Create $release_branch from $branch"
run git switch --quiet -c "$release_branch"
$dry_run || undo_hint="To start over: git checkout -- pyproject.toml uv.lock $changelog && git switch $branch && git branch -D $release_branch"

# --- 4. Version --------------------------------------------------------------
step "4. Bump the version to $new_version"
run uv version "${uv_version_args[@]}"
if ! $dry_run; then
	[ "$(uv version --short)" = "$new_version" ] || die "uv set an unexpected version: $(uv version --short)"
else
	info "pyproject.toml and uv.lock: $current_version -> $new_version"
fi

# --- 5. Changelog ------------------------------------------------------------
step "5. Update $changelog"
if $dry_run; then
	diff -u --label "a/$changelog" --label "b/$changelog" "$changelog" "$new_changelog" || true
else
	cp "$new_changelog" "$changelog"
	git --no-pager diff --stat
fi

# --- 6. Commit ---------------------------------------------------------------
step "6. Commit Release $tag on $release_branch"
run git add pyproject.toml uv.lock "$changelog"
run git commit --quiet -m "Release $tag"

# --- 7. Push and open the PR ---------------------------------------------------
push_cmd=(git push --set-upstream "$remote" "$release_branch")
pr_cmd=(gh pr create --base "$branch" --head "$release_branch" --title "Release $tag" --body-file "$pr_body")
step "7. Push $release_branch and open a PR to $branch"
if $open_pr; then
	run "${push_cmd[@]}"
	$dry_run || undo_hint="$release_branch is pushed; open the PR with: gh pr create --base $branch --head $release_branch --title 'Release $tag' (the body is the [$new_version] section of $changelog)"
	run "${pr_cmd[@]}"
	undo_hint=""
	if $dry_run; then
		info "PR body:"
		sed 's/^/      | /' "$pr_body"
	fi
else
	# --no-pr: keep the body somewhere that outlives this run.
	if ! $dry_run; then
		saved_body="$(git rev-parse --git-dir)/RELEASE_PR_BODY.md"
		cp "$pr_body" "$saved_body"
		pr_cmd=(gh pr create --base "$branch" --head "$release_branch" --title "Release $tag" --body-file "$saved_body")
	fi
	info "not pushing (--no-pr). To push the branch and open the PR, run:"
	printf '\n'
	show_cmd "${push_cmd[@]}"
	show_cmd "${pr_cmd[@]}"
fi

if $dry_run; then
	printf '\nDry run complete: %s -> %s. Nothing was changed.\n' "$current_version" "$new_version"
else
	printf '\nRelease %s committed on %s.\n' "$tag" "$release_branch"
	printf 'Next: merge the PR, then on an up-to-date %s run: mise run release:tag\n' "$branch"
fi
